# Bind management endpoints to loopback by default. Do not expose them publicly.
SENTRY_X_MANAGEMENT_HOST=127.0.0.1
SENTRY_X_MANAGEMENT_PORT=8000

# The SQLite audit database will be created locally in this directory later.
SENTRY_X_AUDIT_DATABASE=./sentry_x_audit.db

# Gemini credentials stay in .env and are never served to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
